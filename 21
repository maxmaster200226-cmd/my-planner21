      const mode = state.todayMode;
      const amt = parseFloat(state.shiftDraft.amount) || 0;
      if ((mode === 'work' || mode === 'both') && amt > 0) {
        if (state.shiftDraft.type === 'card') state.wallet.card += amt;
        else state.wallet.cash += amt;
        state.wallet.shiftsCompleted = (state.wallet.shiftsCompleted || 0) + 1;
        state.wallet.totalShiftEarned = (state.wallet.totalShiftEarned || 0) + amt;

        if (!state.calendar[selectedCalDate]) state.calendar[selectedCalDate] = { type: mode, note: 'Смена' };
        state.calendar[selectedCalDate].income = (state.calendar[selectedCalDate].income || 0) + amt;

        state.shiftDraft.amount = '';
        document.getElementById('shiftEarnedInput').value = '';
