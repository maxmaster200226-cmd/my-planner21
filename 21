      let detailsHtml = '';
      if (selInfo.income) detailsHtml += `<div>💰 Заработано за смену: <strong>${selInfo.income} ₽</strong></div>`;
      if (meds.length) detailsHtml += `<div>💊 Лечение: <strong>${meds.map(m => m.title).join(', ')}</strong></div>`;
      if (doneHabits.length) detailsHtml += `<div>✨ Выполнены привычки: <strong>${doneHabits.map(h => h.title).join(', ')}</strong></div>`;
      document.getElementById('calDayDetails').innerHTML = detailsHtml || 'На этот день пока нет дополнительных записей.';
    }

    function selectCalDate(dateKey) {
      selectedCalDate = dateKey;
      const info = state.calendar[dateKey];
      if (info && ['study','work','both','rest'].includes(info.type)) {
        state.todayMode = info.type;
      }
      renderCalendar();
      renderDay();
      renderHabits();
    }

    function saveCalDay() {
      const type = document.getElementById('calDayType').value;
      const note = document.getElementById('calDayNote').value.trim();
      const prevIncome = (state.calendar[selectedCalDate] && state.calendar[selectedCalDate].income) || 0;
      state.calendar[selectedCalDate] = { type, note, income: prevIncome };
      if (['study','work','both','rest'].includes(type)) state.todayMode = type;
      saveState(); renderCalendar(); renderDay();
      showToast('Отметка дня сохранена в календаре 🗓');
    }

    function clearCalDay() {
      delete state.calendar[selectedCalDate];
      saveState(); renderCalendar();
      showToast('День очищен');
    }

    // ================= 3. УЧЁБА (ХИМИЯ, БИОЛОГИЯ, АНГЛИЙСКИЙ) =================
    const subjNames = {
      chem: '🧪 Химия ЕГЭ',
      bio: '🧬 Биология ЕГЭ',
      eng: '🇬🇧 Английский ЕГЭ'
    };

    function switchStudySubject(subj, btn) {
      currentStudySubj = subj;
      btn.parentElement.querySelectorAll('.subtab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderStudy();
    }

    function renderStudy() {
      const data = state.study[currentStudySubj];
      document.getElementById('studySubjTitle').textContent = `Кодификатор: ${subjNames[currentStudySubj]}`;
      document.getElementById('studyNotesTitle').textContent = currentStudySubj === 'eng'
        ? '🇬🇧 Словарь, Phrasal Verbs и клише для Эссе/Устной части'
        : '💡 Сложные реакции, алгоритмы и мои ловушки';

      // Темы
      const tBox = document.getElementById('studyTopicsList');
      tBox.innerHTML = '';
      let totalSteps = data.topics.length * 3;
      let doneSteps = 0;

      data.topics.forEach(t => {
        if (t.s1) doneSteps++; if (t.s2) doneSteps++; if (t.s3) doneSteps++;
        const item = document.createElement('div');
        item.className = 'list-item';
        item.style.flexDirection = 'column';
        item.style.alignItems = 'stretch';
        item.innerHTML = `
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <strong style="font-size:14px;">${t.title}</strong>
            <button class="del-btn" onclick="deleteStudyTopic(${t.id})">×</button>
          </div>
          <div class="step-pills" style="margin-top:6px;">
            <button class="step-pill ${t.s1 ? 'done' : ''}" onclick="toggleStudyStep(${t.id}, 's1')">1. Теория</button>
            <button class="step-pill ${t.s2 ? 'done' : ''}" onclick="toggleStudyStep(${t.id}, 's2')">2. Практика</button>
            <button class="step-pill ${t.s3 ? 'done' : ''}" onclick="toggleStudyStep(${t.id}, 's3')">3. Повторено</button>
          </div>
        `;
        tBox.appendChild(item);
      });
      const pct = totalSteps ? Math.round((doneSteps / totalSteps) * 100) : 0;
      document.getElementById('studySubjProgress').textContent = `${pct}% освоено`;

      // Ловушки / Словарь
      const trBox = document.getElementById('studyTrapsList');
      trBox.innerHTML = data.traps.map(tr => `
        <div class="comment-box">
          <div><strong>${tr.term}</strong> — ${tr.desc}</div>
          <button class="del-btn" onclick="deleteStudyTrap(${tr.id})">×</button>
        </div>
      `).join('');

      // Пробники
      const mBox = document.getElementById('studyMocksList');
      mBox.innerHTML = data.mocks.map(m => `
        <div class="comment-box">
          <div>
            <div style="font-size:11px; color:var(--text-muted);">${m.date} • <strong>${m.score} баллов</strong></div>
            <div>${m.comment}</div>
          </div>
          <button class="del-btn" onclick="deleteStudyMock(${m.id})">×</button>
        </div>
      `).join('');
    }

    function addStudyTopic() {
      const inp = document.getElementById('newStudyTopic');
      if (!inp.value.trim()) return;
      state.study[currentStudySubj].topics.push({ id: Date.now(), title: inp.value.trim(), s1: false, s2: false, s3: false });
      inp.value = ''; saveState(); renderStudy();
    }
    function toggleStudyStep(id, step) {
      const t = state.study[currentStudySubj].topics.find(x => x.id === id);
      if (t) t[step] = !t[step];
      saveState(); renderStudy();
    }
    function deleteStudyTopic(id) {
      state.study[currentStudySubj].topics = state.study[currentStudySubj].topics.filter(x => x.id !== id);
      saveState(); renderStudy();
    }
    function addStudyTrap() {
      const term = document.getElementById('trapTerm');
      const desc = document.getElementById('trapDesc');
      if (!term.value.trim()) return;
      state.study[currentStudySubj].traps.push({ id: Date.now(), term: term.value.trim(), desc: desc.value.trim() });
      term.value = ''; desc.value = ''; saveState(); renderStudy();
    }
    function deleteStudyTrap(id) {
      state.study[currentStudySubj].traps = state.study[currentStudySubj].traps.filter(x => x.id !== id);
      saveState(); renderStudy();
    }
    function addStudyMock() {
      const sc = document.getElementById('mockScore');
      const cm = document.getElementById('mockComment');
      if (!sc.value) return;
      const d = new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
      state.study[currentStudySubj].mocks.unshift({ id: Date.now(), date: d, score: parseInt(sc.value, 10), comment: cm.value.trim() });
      sc.value = ''; cm.value = ''; saveState(); renderStudy();
    }
    function deleteStudyMock(id) {
      state.study[currentStudySubj].mocks = state.study[currentStudySubj].mocks.filter(x => x.id !== id);
      saveState(); renderStudy();
    }

    // ================= 4. КОШЕЛЁК =================
    function promptEditBalance() {
      const newCard = prompt('Введи сумму НА КАРТЕ (₽):', state.wallet.card);
      if (newCard !== null && !isNaN(parseFloat(newCard))) state.wallet.card = parseFloat(newCard);
      const newCash = prompt('Введи сумму НАЛИЧНЫМИ (₽):', state.wallet.cash);
      if (newCash !== null && !isNaN(parseFloat(newCash))) state.wallet.cash = parseFloat(newCash);
      saveState(); renderWallet();
    }

    function renderWallet() {
      const total = (state.wallet.card || 0) + (state.wallet.cash || 0);
      document.getElementById('walletTotalDisplay').textContent = total.toLocaleString('ru-RU') + ' ₽';
      document.getElementById('walletCardDisplay').textContent = (state.wallet.card || 0).toLocaleString('ru-RU') + ' ₽';
      document.getElementById('walletCashDisplay').textContent = (state.wallet.cash || 0).toLocaleString('ru-RU') + ' ₽';

      // Расходы
      document.getElementById('expensesList').innerHTML = state.wallet.expenses.map(e => `
        <div class="list-item">
          <div>
            <strong>${e.title}</strong> • <span style="color:var(--danger); font-weight:700;">-${e.amount} ₽</span>
            <div style="font-size:11px; color:var(--text-muted);">${e.source === 'card' ? '💳 С карты' : '💵 Наличные'} • ${e.date}</div>
          </div>
          <button class="del-btn" onclick="deleteExpense(${e.id})">×</button>
        </div>
      `).join('') || '<div style="font-size:13px; color:var(--text-muted);">Пока нет записей о расходах</div>';

      // Копилки (до 20)
      document.getElementById('piggyCountBadge').textContent = `${state.wallet.piggy.length} / 20`;
      document.getElementById('piggyList').innerHTML = state.wallet.piggy.map(p => {
        const pct = p.target ? Math.min(100, Math.round((p.saved / p.target) * 100)) : 0;
        return `
          <div style="padding:13px; background:var(--surface-soft); border-radius:16px; margin-bottom:10px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <strong>🐷 ${p.name}</strong>
              <div style="display:flex; align-items:center; gap:6px;">
                <span class="badge">${p.saved.toLocaleString('ru-RU')} / ${p.target.toLocaleString('ru-RU')} ₽ (${pct}%)</span>
                <button class="del-btn" onclick="deletePiggy(${p.id})">×</button>
              </div>
            </div>
            <div class="progress-wrap"><div class="progress-fill" style="width:${pct}%"></div></div>
            <div class="input-row" style="margin-top:6px;">
              <input type="number" id="piggyAddAmt-${p.id}" placeholder="Сумма пополнения (₽)">
              <select id="piggyAddSrc-${p.id}">
                <option value="card">💳 С карты</option>
                <option value="cash">💵 С наличных</option>
              </select>
              <button class="btn" onclick="topUpPiggy(${p.id})">+ В копилку</button>
            </div>
          </div>
        `;
      }).join('');

      // Долги (до 20)
      document.getElementById('debtsCountBadge').textContent = `${state.wallet.debts.length} / 20`;
      document.getElementById('debtsList').innerHTML = state.wallet.debts.map(d => `
        <div class="list-item">
          <div>
            <strong>${d.who}</strong> — <span style="color:var(--danger); font-weight:700;">${d.sum} ₽</span>
            <div style="font-size:12px; color:var(--text-muted);">${d.note || 'Без комментария'}</div>
          </div>
          <div style="display:flex; gap:6px;">
            <button class="btn-soft" onclick="payDebt(${d.id}, 'card')" title="Вернуть с карты">💳</button>
            <button class="btn-soft" onclick="payDebt(${d.id}, 'cash')" title="Вернуть наличными">💵</button>
            <button class="del-btn" onclick="deleteDebt(${d.id})">×</button>
          </div>
        </div>
      `).join('') || '<div style="font-size:13px; color:var(--text-muted);">Долгов нет! 🎉</div>';

      // Запланированное
      const planSum = state.wallet.planned.reduce((acc, x) => acc + (x.est || 0), 0);
      document.getElementById('plannedTotalBadge').textContent = `Итого примерно: ${planSum.toLocaleString('ru-RU')} ₽`;
      document.getElementById('plannedList').innerHTML = state.wallet.planned.map(pl => `
        <div class="list-item">
          <div><strong>${pl.title}</strong> • <span style="color:var(--primary); font-weight:700;">~${pl.est} ₽</span></div>
          <button class="del-btn" onclick="deletePlanned(${pl.id})">×</button>
        </div>
      `).join('');
    }

    function addExpense() {
      const title = document.getElementById('expTitle').value.trim();
      const amount = parseFloat(document.getElementById('expAmount').value);
      const source = document.getElementById('expSource').value;
      if (!title || isNaN(amount) || amount <= 0) return;

      if (source === 'card') state.wallet.card -= amount;
      else state.wallet.cash -= amount;

      const d = new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
      state.wallet.expenses.unshift({ id: Date.now(), title, amount, source, date: d });
      document.getElementById('expTitle').value = '';
      document.getElementById('expAmount').value = '';
      saveState(); renderWallet();
      showToast(`Списано ${amount} ₽ (${source === 'card' ? 'Карта' : 'Наличные'})`);
    }
    function deleteExpense(id) {
      state.wallet.expenses = state.wallet.expenses.filter(x => x.id !== id);
      saveState(); renderWallet();
    }

    function addPiggy() {
      if (state.wallet.piggy.length >= 20) return showToast('Максимум 20 копилок');
      const name = document.getElementById('newPiggyName').value.trim();
      const target = parseFloat(document.getElementById('newPiggyTarget').value) || 0;
      const saved = parseFloat(document.getElementById('newPiggyInitial').value) || 0;
      if (!name || target <= 0) return;
      state.wallet.piggy.push({ id: Date.now(), name, target, saved });
      document.getElementById('newPiggyName').value = '';
      document.getElementById('newPiggyTarget').value = '';
      document.getElementById('newPiggyInitial').value = '';
      saveState(); renderWallet();
    }
    function topUpPiggy(id) {
      const p = state.wallet.piggy.find(x => x.id === id);
      const amt = parseFloat(document.getElementById('piggyAddAmt-' + id).value);
      const src = document.getElementById('piggyAddSrc-' + id).value;
      if (!p || isNaN(amt) || amt <= 0) return;

      if (src === 'card') state.wallet.card -= amt;
      else state.wallet.cash -= amt;
      p.saved += amt;
      saveState(); renderWallet();
      showToast(`🐷 +${amt} ₽ переведено в копилку «${p.name}»!`);
    }
    function deletePiggy(id) {
      state.wallet.piggy = state.wallet.piggy.filter(x => x.id !== id);
      saveState(); renderWallet();
    }

    function addDebt() {
      if (state.wallet.debts.length >= 20) return showToast('Максимум 20 записей долгов');
      const who = document.getElementById('debtWho').value.trim();
      const sum = parseFloat(document.getElementById('debtSum').value);
      const note = document.getElementById('debtNote').value.trim();
      if (!who || isNaN(sum)) return;
      state.wallet.debts.push({ id: Date.now(), who, sum, note });
      document.getElementById('debtWho').value = '';
      document.getElementById('debtSum').value = '';
      document.getElementById('debtNote').value = '';
      saveState(); renderWallet();
    }
    function payDebt(id, src) {
      const d = state.wallet.debts.find(x => x.id === id);
      if (!d) return;
      if (src === 'card') state.wallet.card -= d.sum;
      else state.wallet.cash -= d.sum;
      state.wallet.debts = state.wallet.debts.filter(x => x.id !== id);
      saveState(); renderWallet();
      showToast(`Долг (${d.sum} ₽) закрыт и вычтен из баланса!`);
    }
    function deleteDebt(id) {
      state.wallet.debts = state.wallet.debts.filter(x => x.id !== id);
      saveState(); renderWallet();
    }

    function addPlannedItem() {
      const title = document.getElementById('planTitle').value.trim();
      const est = parseFloat(document.getElementById('planEst').value) || 0;
      if (!title) return;
      state.wallet.planned.push({ id: Date.now(), title, est });
      document.getElementById('planTitle').value = '';
      document.getElementById('planEst').value = '';
      saveState(); renderWallet();
    }
    function deletePlanned(id) {
      state.wallet.planned = state.wallet.planned.filter(x => x.id !== id);
      saveState(); renderWallet();
    }

    // ================= 5. ТРЕНИРОВКИ =================
    function selectWorkoutPreset(label, mins) {
      document.getElementById('spWorkType').value = label;
      document.getElementById('spWorkMin').value = mins;
    }
    function addSportLog(cat, minId, noteId) {
      const min = parseInt(document.getElementById(minId).value, 10) || 15;
      const note = document.getElementById(noteId).value.trim();
      const d = new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
      state.sport.unshift({ id: Date.now(), cat, min, km: 0, note, date: d });
      document.getElementById(minId).value = '';
      document.getElementById(noteId).value = '';
      saveState(); renderSport();
      showToast(`Записано: ${cat} (${min} мин) 💪`);
    }
    function addTreadmillLog() {
      const min = parseInt(document.getElementById('spTreadMin').value, 10) || 30;
      const km = parseFloat(document.getElementById('spTreadKm').value) || 0;
      const note = document.getElementById('spTreadNote').value.trim();
      const d = new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
      state.sport.unshift({ id: Date.now(), cat: 'Дорожка', min, km, note: `${km} км • ${note}`, date: d });
      document.getElementById('spTreadMin').value = '';
      document.getElementById('spTreadKm').value = '';
      document.getElementById('spTreadNote').value = '';
      saveState(); renderSport();
      showToast('Пробежка/ходьба сохранена 🏃‍♀️');
    }
    function addWorkoutPresetLog() {
      const type = document.getElementById('spWorkType').value.trim() || 'Тренировка';
      const min = parseInt(document.getElementById('spWorkMin').value, 10) || 45;
      const note = document.getElementById('spWorkNote').value.trim();
      const d = new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
      state.sport.unshift({ id: Date.now(), cat: type, min, km: 0, note, date: d });
      document.getElementById('spWorkNote').value = '';
      saveState(); renderSport();
      showToast(`Тренировка «${type}» сохранена!`);
    }
    function deleteSportLog(id) {
      state.sport = state.sport.filter(x => x.id !== id);
      saveState(); renderSport();
    }
    function renderSport() {
      document.getElementById('sportLogsList').innerHTML = state.sport.map(s => `
        <div class="list-item">
          <div>
            <strong>${s.cat}</strong> • <span style="color:var(--primary); font-weight:700;">${s.min} мин</span>
            <span style="font-size:11px; color:var(--text-muted);">(${s.date})</span>
            <div style="font-size:12px; color:var(--text-muted);">${s.note || ''}</div>
          </div>
          <button class="del-btn" onclick="deleteSportLog(${s.id})">×</button>
        </div>
      `).join('');
    }

    // ================= 6. ТРЕКЕР ПРИВЫЧЕК =================
    function filterHabits(cat, btn) {
      currentHabitFilter = cat;
      btn.parentElement.querySelectorAll('.subtab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderHabits();
    }
    function renderHabits() {
      document.getElementById('habitDateBadge').textContent = `Дата: ${selectedCalDate}`;
      const list = state.habits.filter(h => currentHabitFilter === 'all' || h.cat === currentHabitFilter);
      document.getElementById('habitsList').innerHTML = list.map(h => {
        const doneToday = !!(h.days && h.days[selectedCalDate]);
        const totalDays = h.days ? Object.keys(h.days).length : 0;
        return `
          <div class="list-item">
            <div class="item-left" onclick="toggleHabitDay(${h.id})">
              <div class="checkbox ${doneToday ? 'checked' : ''}">${doneToday ? '✓' : ''}</div>
              <div>
                <div style="font-weight:700; font-size:14px;">${h.title}</div>
                <div style="font-size:11px; color:var(--text-muted);">${h.cat} • В копилке дней: ${totalDays} 🌱</div>
              </div>
            </div>
            <button class="del-btn" onclick="deleteHabit(${h.id})">×</button>
          </div>
        `;
      }).join('');
    }
    function addHabit() {
      const inp = document.getElementById('newHabitTitle');
      const cat = document.getElementById('newHabitCat').value;
      if (!inp.value.trim()) return;
      state.habits.push({ id: Date.now(), title: inp.value.trim(), cat, days: {} });
      inp.value = ''; saveState(); renderHabits();
    }
    function toggleHabitDay(id) {
      const h = state.habits.find(x => x.id === id);
      if (!h) return;
      if (!h.days) h.days = {};
      if (h.days[selectedCalDate]) delete h.days[selectedCalDate];
      else h.days[selectedCalDate] = true;
      saveState(); renderHabits(); renderCalendar();
    }
    function deleteHabit(id) {
      state.habits = state.habits.filter(x => x.id !== id);
      saveState(); renderHabits(); renderCalendar();
    }

    // ================= 7. КНИГИ (3 ВКЛАДКИ) =================
    const bookTabTitles = {
      reading: '📖 Читаю сейчас',
      read: '✅ Прочитанные книги',
      want: '🔖 Хочу прочитать'
    };
    function switchBookTab(tab, btn) {
      currentBookTab = tab;
      btn.parentElement.querySelectorAll('.subtab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('bookTabHeading').textContent = bookTabTitles[tab];
      renderBooks();
    }
    function renderBooks() {
      const books = state.books.filter(b => b.status === currentBookTab);
      const box = document.getElementById('booksListContainer');
      box.innerHTML = books.map(b => {
        const pct = b.totalPages ? Math.min(100, Math.round((b.curPage / b.totalPages) * 100)) : 0;
        return `
          <div style="padding:14px; background:var(--surface-soft); border-radius:16px; margin-bottom:12px;">
            <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
              <strong>${b.title}</strong>
              <div style="display:flex; gap:6px; align-items:center;">
                <span class="badge">${b.curPage} / ${b.totalPages} стр. (${pct}%)</span>
                <button class="del-btn" onclick="deleteBook(${b.id})">×</button>
              </div>
            </div>
            <div class="progress-wrap"><div class="progress-fill" style="width:${pct}%"></div></div>
            <div class="input-row" style="margin-top:8px;">
              <input type="number" value="${b.curPage}" placeholder="Стр. сейчас" style="max-width:120px;" onchange="updateBookPage(${b.id}, this.value)">
              <input type="text" id="bNoteInp-${b.id}" placeholder="Цитата или мысль по книге...">
              <button class="btn" onclick="addBookNote(${b.id})">💬</button>
              ${b.status !== 'read' ? `<button class="btn-soft" onclick="moveBookStatus(${b.id}, 'read')">✅ Дочитала</button>` : ''}
              ${b.status === 'want' ? `<button class="btn-soft" onclick="moveBookStatus(${b.id}, 'reading')">📖 Начать</button>` : ''}
            </div>
            <div>
              ${(b.notes || []).map(n => `
                <div class="comment-box" style="background:var(--surface-solid);">
                  <div><span style="font-size:11px; color:var(--text-muted);">Стр. ${n.page}:</span> ${n.text}</div>
                  <button class="del-btn" onclick="deleteBookNote(${b.id}, ${n.id})">×</button>
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }).join('') || '<div style="font-size:13px; color:var(--text-muted);">В этом разделе пока нет книг</div>';
    }
    function addBook() {
      const title = document.getElementById('newBookTitle').value.trim();
      const totalPages = parseInt(document.getElementById('newBookTotalPages').value, 10) || 300;
      if (!title) return;
      state.books.push({
        id: Date.now(), status: currentBookTab, title,
        curPage: currentBookTab === 'read' ? totalPages : 0,
        totalPages, notes: []
      });
      document.getElementById('newBookTitle').value = '';
      document.getElementById('newBookTotalPages').value = '';
      saveState(); renderBooks();
    }
    function updateBookPage(id, val) {
      const b = state.books.find(x => x.id === id);
      if (b) b.curPage = Math.max(0, parseInt(val, 10) || 0);
      saveState(); renderBooks();
    }
    function moveBookStatus(id, st) {
      const b = state.books.find(x => x.id === id);
      if (b) {
        b.status = st;
        if (st === 'read') b.curPage = b.totalPages;
      }
      saveState(); renderBooks();
    }
    function addBookNote(bookId) {
      const b = state.books.find(x => x.id === bookId);
      const inp = document.getElementById('bNoteInp-' + bookId);
      if (!b || !inp.value.trim()) return;
      b.notes.unshift({ id: Date.now(), page: b.curPage, text: inp.value.trim() });
      inp.value = ''; saveState(); renderBooks();
    }
    function deleteBookNote(bookId, noteId) {
      const b = state.books.find(x => x.id === bookId);
      if (b) b.notes = b.notes.filter(n => n.id !== noteId);
      saveState(); renderBooks();
    }
    function deleteBook(id) {
      state.books = state.books.filter(x => x.id !== id);
      saveState(); renderBooks();
    }

    // ================= 8. Я (ВОЛОСЫ, ЛЕЧЕНИЕ, ЦЕЛИ) =================
    function renderMe() {
      // Волосы
      document.getElementById('hairList').innerHTML = state.me.hair.map(h => `
        <div class="list-item ${h.done ? 'done' : ''}">
          <div class="item-left" onclick="toggleHair(${h.id})">
            <div class="checkbox ${h.done ? 'checked' : ''}">${h.done ? '✓' : ''}</div>
            <span class="item-title" style="font-weight:600; font-size:14px;">${h.text}</span>
          </div>
          <button class="del-btn" onclick="deleteHair(${h.id})">×</button>
        </div>
      `).join('');

      // Лечение
      document.getElementById('medList').innerHTML = state.me.med.map(m => `
        <div class="list-item ${m.done ? 'done' : ''}">
          <div class="item-left" onclick="toggleMed(${m.id})">
            <div class="checkbox ${m.done ? 'checked' : ''}">${m.done ? '✓' : ''}</div>
            <div>
              <div class="item-title" style="font-weight:700; font-size:14px;">💊 ${m.title}</div>
              <div style="font-size:11px; color:var(--text-muted);">Дата в календаре: ${m.date}</div>
            </div>
          </div>
          <button class="del-btn" onclick="deleteMed(${m.id})">×</button>
        </div>
      `).join('');

      // Цели
      document.getElementById('goalsList').innerHTML = state.me.goals.map(g => `
        <div class="list-item ${g.done ? 'done' : ''}">
          <div class="item-left" onclick="toggleGoal(${g.id})">
            <div class="checkbox ${g.done ? 'checked' : ''}">${g.done ? '✓' : ''}</div>
            <div>
              <div class="item-title" style="font-weight:700; font-size:14px;">${g.title}</div>
              <div style="font-size:11px; color:var(--primary); font-weight:600;">${g.cat}</div>
            </div>
          </div>
          <button class="del-btn" onclick="deleteGoal(${g.id})">×</button>
        </div>
      `).join('');
    }

    function addHairItem() {
      const inp = document.getElementById('newHairItem');
      if (!inp.value.trim()) return;
      state.me.hair.push({ id: Date.now(), text: inp.value.trim(), done: false });
      inp.value = ''; saveState(); renderMe();
    }
    function toggleHair(id) {
      const h = state.me.hair.find(x => x.id === id);
      if (h) h.done = !h.done;
      saveState(); renderMe();
    }
    function deleteHair(id) {
      state.me.hair = state.me.hair.filter(x => x.id !== id);
      saveState(); renderMe();
    }

    function addMedItem() {
      const title = document.getElementById('newMedTitle').value.trim();
      const date = document.getElementById('newMedDate').value || selectedCalDate;
      if (!title) return;
      state.me.med.push({ id: Date.now(), title, date, done: false });
      document.getElementById('newMedTitle').value = '';
      saveState(); renderMe(); renderCalendar(); renderDay();
      showToast('💊 Добавлено в Лечение и синхронизировано с Календарём!');
    }
    function toggleMed(id) {
      const m = state.me.med.find(x => x.id === id);
      if (m) m.done = !m.done;
      saveState(); renderMe(); renderDay();
    }
    function deleteMed(id) {
      state.me.med = state.me.med.filter(x => x.id !== id);
      saveState(); renderMe(); renderCalendar(); renderDay();
    }

    function addGoalItem() {
      const title = document.getElementById('newGoalTitle').value.trim();
      const cat = document.getElementById('newGoalCat').value;
      if (!title) return;
      state.me.goals.push({ id: Date.now(), title, cat, done: false });
      document.getElementById('newGoalTitle').value = '';
      saveState(); renderMe();
    }
    function toggleGoal(id) {
      const g = state.me.goals.find(x => x.id === id);
      if (g) g.done = !g.done;
      saveState(); renderMe();
    }
    function deleteGoal(id) {
      state.me.goals = state.me.goals.filter(x => x.id !== id);
      saveState(); renderMe();
    }

    // ================= 9. ИТОГИ И ОТЧЁТЫ =================
    function renderStats() {
      // Учёба
      const allTopics = [...state.study.chem.topics, ...state.study.bio.topics, ...state.study.eng.topics];
      const fullyMastered = allTopics.filter(t => t.s1 && t.s2 && t.s3).length;
      document.getElementById('statBoxStudy').innerHTML = `
        <div class="card-title">📚 Сводка по ЕГЭ (Химия, Биология, Английский)</div>
        <p style="margin-top:8px; font-size:14px;">Всего тем в плане: <strong>${allTopics.length}</strong> • Полностью закрыто (3/3 шага): <strong>${fullyMastered}</strong></p>
        <p style="font-size:14px;">Написано пробников: <strong>${state.study.chem.mocks.length + state.study.bio.mocks.length + state.study.eng.mocks.length}</strong></p>
      `;

      // Работа
      document.getElementById('statBoxWork').innerHTML = `
        <div class="card-title">☕ Сводка по рабочим сменам</div>
        <p style="margin-top:8px; font-size:14px;">Закрыто смен: <strong>${state.wallet.shiftsCompleted || 0}</strong></p>
        <p style="font-size:14px;">Всего заработано со смен: <strong>${(state.wallet.totalShiftEarned || 0).toLocaleString('ru-RU')} ₽</strong></p>
      `;

      // Спорт
      const totalSportMin = state.sport.reduce((a, b) => a + (b.min || 0), 0);
      const totalKm = state.sport.reduce((a, b) => a + (b.km || 0), 0).toFixed(1);
      document.getElementById('statBoxSport').innerHTML = `
        <div class="card-title">🧘‍♀️ Сводка по тренировкам и спине</div>
        <p style="margin-top:8px; font-size:14px;">Всего занятий: <strong>${state.sport.length}</strong> • Общее время: <strong>${totalSportMin} мин</strong></p>
        <p style="font-size:14px;">Пройдено на беговой дорожке: <strong>${totalKm} км</strong></p>
      `;

      // Книги
      const readCount = state.books.filter(b => b.status === 'read').length;
      const readingCount = state.books.filter(b => b.status === 'reading').length;
      document.getElementById('statBoxBooks').innerHTML = `
        <div class="card-title">📖 Книжная статистика</div>
        <p style="margin-top:8px; font-size:14px;">Прочитано книг: <strong>${readCount}</strong> • Читаю сейчас: <strong>${readingCount}</strong></p>
      `;

      // Отчёты
      document.getElementById('reportsList').innerHTML = state.reports.map(r => `
        <div class="comment-box">
          <div>
            <div style="font-size:11px; color:var(--text-muted);">${r.cat} • ${r.date}</div>
            <div style="font-weight:700; margin:2px 0;">${r.title}</div>
            <div>${r.text}</div>
          </div>
          <button class="del-btn" onclick="deleteReport(${r.id})">×</button>
        </div>
      `).join('');
    }

    function addReport() {
      const cat = document.getElementById('repCat').value;
      const title = document.getElementById('repTitle').value.trim();
      const text = document.getElementById('repText').value.trim();
      if (!title && !text) return;
      const d = new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
      state.reports.unshift({ id: Date.now(), cat, title: title || 'Итог', text, date: d });
      document.getElementById('repTitle').value = '';
      document.getElementById('repText').value = '';
      saveState(); renderStats();
      showToast('Отчёт сохранён 📊');
    }
    function deleteReport(id) {
      state.reports = state.reports.filter(x => x.id !== id);
      saveState(); renderStats();
    }

    // ================= ТАЙМЕР ПОМОДОРО =================
    let pomoSec = 25 * 60;
    let pomoTimer = null;
    function togglePomo() {
      if (pomoTimer) {
        clearInterval(pomoTimer);
        pomoTimer = null;
        showToast('Таймер на паузе ⏸');
      } else {
        showToast('Таймер запущен! 25 минут фокуса 🍅');
        pomoTimer = setInterval(() => {
          if (pomoSec > 0) {
            pomoSec--;
            const m = String(Math.floor(pomoSec / 60)).padStart(2, '0');
            const s = String(pomoSec % 60).padStart(2, '0');
            document.getElementById('pomoTime').textContent = `${m}:${s}`;
          } else {
            clearInterval(pomoTimer);
            pomoTimer = null;
            pomoSec = 25 * 60;
            showToast('🍅 Время вышло! Сделай разминку для спины ✨');
          }
        }, 1000);
      }
    }

    // ================= ИНИЦИАЛИЗАЦИЯ =================
    function renderAll() {
      renderDay();
      renderCalendar();
      renderStudy();
      renderWallet();
      renderSport();
      renderHabits();
      renderBooks();
      renderMe();
      renderStats();
    }

    window.addEventListener('DOMContentLoaded', () => {
      setTheme(state.theme || 'blush');
      initCalSelect();
      document.getElementById('newMedDate').value = selectedCalDate;
      renderAll();
    });
  </script>
</body>
</html>
